<section class="how-it-works section" id="shopify-section-{{ section.id }}">
  <div class="page-width">
    <div class="section-header section-header--center">
      <h2>
        {%- if section.settings.heading != blank -%}
          {{ section.settings.heading }}
        {%- else -%}
          {{ 'sections.how_it_works.default_heading' | t }}
        {%- endif -%}
      </h2>
      <p class="section-header__subheading">
        {%- if section.settings.subheading != blank -%}
          {{ section.settings.subheading }}
        {%- else -%}
          {{ 'sections.how_it_works.default_subheading' | t }}
        {%- endif -%}
      </p>
    </div>

    <ol class="how-it-works__steps">
      {%- for block in section.blocks -%}
        <li class="how-it-works__step" {{ block.shopify_attributes }}>
          <span class="how-it-works__number">{{ forloop.index }}</span>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{{ 'section-how-it-works.css' | asset_url | stylesheet_tag }}

{% schema %}
{
  "name": "Comment ça marche",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Sous-titre"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Étape",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Titre"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Texte"
        }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Comment ça marche",
      "blocks": [
        { "type": "step", "settings": { "title": "Je choisis ma routine", "text": "Un produit ciblé ou un bundle pensé pour se compléter." } },
        { "type": "step", "settings": { "title": "J'intègre le geste quotidien", "text": "Un rituel simple, au moment qui vous convient le mieux." } },
        { "type": "step", "settings": { "title": "Je suis ma régularité", "text": "La constance fait la différence, jour après jour." } }
      ]
    }
  ]
}
{% endschema %}
