<section class="video-section section" id="shopify-section-{{ section.id }}">
  <div class="page-width page-width--narrow">
    {%- if section.settings.heading != blank or section.settings.text != blank -%}
      <div class="section-header section-header--center">
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="section-header__subheading">{{ section.settings.text }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="video-section__frame">
      {%- if section.settings.video -%}
        {{ section.settings.video | video_tag: image_size: '1100x', controls: true, preload: 'metadata', class: 'video-section__native' }}
      {%- elsif section.settings.external_video_url != blank -%}
        <video-facade
          class="video-section__facade"
          data-video-url="{{ section.settings.external_video_url | escape }}"
        >
          <button type="button" class="video-section__play" aria-label="{{ 'sections.video.play' | t }}">
            {%- if section.settings.cover_image -%}
              <img
                src="{{ section.settings.cover_image | image_url: width: 1100 }}"
                srcset="{{ section.settings.cover_image | image_url: width: 600 }} 600w, {{ section.settings.cover_image | image_url: width: 1100 }} 1100w"
                sizes="(min-width: 700px) 46rem, 100vw"
                alt=""
                width="{{ section.settings.cover_image.width }}"
                height="{{ section.settings.cover_image.height }}"
                loading="lazy"
              >
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'video-section__placeholder' }}
            {%- endif -%}
            <span class="video-section__play-icon" aria-hidden="true">
              {%- render 'icon', name: 'chevron-right', size: 28 -%}
            </span>
          </button>
        </video-facade>
      {%- else -%}
        <p class="video-section__empty">Ajoutez une vidéo hébergée par Shopify ou une URL (YouTube/Vimeo) dans les réglages de cette section.</p>
      {%- endif -%}
    </div>
  </div>
</section>

{{ 'section-video.css' | asset_url | stylesheet_tag }}
{%- if section.settings.external_video_url != blank -%}
  <script src="{{ 'section-video.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "Vidéo",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Vidéo hébergée par Shopify",
      "info": "Prioritaire sur l'URL externe si les deux sont renseignés. Recommandé : pas de dépendance externe, chargement optimisé par le CDN Shopify."
    },
    {
      "type": "url",
      "id": "external_video_url",
      "label": "URL vidéo externe (YouTube / Vimeo)",
      "info": "Utilisée uniquement si aucune vidéo Shopify n'est sélectionnée ci-dessus. Chargée uniquement au clic pour ne pas ralentir la page."
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "Image de couverture (pour l'URL externe)"
    }
  ],
  "presets": [
    {
      "name": "Vidéo"
    }
  ]
}
{% endschema %}
