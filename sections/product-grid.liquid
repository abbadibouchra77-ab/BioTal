<section class="product-grid-section section" id="shopify-section-{{ section.id }}">
  <div class="page-width">
    <div class="section-header {% if section.settings.center_heading %}section-header--center{% endif %}">
      <h2>
        {%- if section.settings.heading != blank -%}
          {{ section.settings.heading }}
        {%- else -%}
          {{ 'sections.product_grid.default_heading' | t }}
        {%- endif -%}
      </h2>
      <p class="section-header__subheading">
        {%- if section.settings.subheading != blank -%}
          {{ section.settings.subheading }}
        {%- else -%}
          {{ 'sections.product_grid.default_subheading' | t }}
        {%- endif -%}
      </p>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="grid grid--3">
        {%- for block in section.blocks -%}
          {%- if block.settings.product != blank -%}
            <div {{ block.shopify_attributes }}>
              {%- render 'product-card', product: block.settings.product -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.view_all_link != blank -%}
      <div class="product-grid-section__footer">
        <a href="{{ section.settings.view_all_link }}" class="btn btn--outline">{{ 'sections.product_grid.view_all' | t }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Grille produits",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Sous-titre"
    },
    {
      "type": "checkbox",
      "id": "center_heading",
      "label": "Centrer le titre",
      "default": true
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "Lien « Voir tout »"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Produit",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Produit ou bundle"
        }
      ]
    }
  ],
  "max_blocks": 24,
  "presets": [
    {
      "name": "Grille produits",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
