<section class="reviews section" id="shopify-section-{{ section.id }}">
  <div class="page-width">
    <div class="section-header section-header--center">
      <h2>
        {%- if section.settings.heading != blank -%}
          {{ section.settings.heading }}
        {%- else -%}
          {{ 'sections.reviews.default_heading' | t }}
        {%- endif -%}
      </h2>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="reviews__grid">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              <div {{ block.shopify_attributes }}>
                {%- render block -%}
              </div>
            {%- when 'review' -%}
              <div class="review-card card" {{ block.shopify_attributes }}>
                <div class="review-card__stars" aria-hidden="true">
                  {%- for i in (1..5) -%}
                    {%- if i <= block.settings.rating -%}
                      {%- render 'icon', name: 'star', size: 14 -%}
                    {%- else -%}
                      {%- render 'icon', name: 'star-outline', size: 14 -%}
                    {%- endif -%}
                  {%- endfor -%}
                </div>
                <p class="review-card__quote">
                  {%- render 'icon', name: 'quote', size: 18 -%}
                  {{ block.settings.quote }}
                </p>
                <p class="review-card__author">
                  {{ block.settings.author }}
                  {%- if block.settings.verified -%}
                    <span class="review-card__verified">· {{ 'sections.reviews.verified' | t }}</span>
                  {%- endif -%}
                </p>
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="reviews__empty">{{ 'sections.reviews.no_reviews' | t }}</p>
    {%- endif -%}
  </div>
</section>

{{ 'section-reviews.css' | asset_url | stylesheet_tag }}

{% schema %}
{
  "name": "Avis clients",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Avis (manuel)",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Note",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Avis"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Auteur"
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Achat vérifié",
          "default": true
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Avis clients"
    }
  ]
}
{% endschema %}
