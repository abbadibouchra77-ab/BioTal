<div class="search-results section">
  <div class="page-width">
    <div class="section-header section-header--center">
      <h1>{{ 'general.search.title' | t }}</h1>
      <form action="{{ routes.search_url }}" method="get" role="search" class="search-results__form">
        <input type="hidden" name="type" value="product,page,article">
        <label for="SearchInput" class="visually-hidden">{{ 'general.search.placeholder' | t }}</label>
        <input
          type="search"
          id="SearchInput"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{{ 'general.search.placeholder' | t }}"
        >
        <button type="submit" class="btn btn--primary">{{ 'general.search.submit' | t }}</button>
      </form>
    </div>

    {%- if search.performed -%}
      {%- if search.results_count > 0 -%}
        <p class="search-results__count">
          {{ 'general.search.results_count' | t: count: search.results_count }}
        </p>
        <div class="grid grid--3">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {%- render 'product-card', product: item -%}
            {%- else -%}
              <article class="article-card card">
                <a href="{{ item.url }}" class="article-card__media">
                  {%- if item.image -%}
                    <img src="{{ item.image | image_url: width: 600 }}" alt="{{ item.title | escape }}" width="600" height="450" loading="lazy">
                  {%- else -%}
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'article-card__placeholder' }}
                  {%- endif -%}
                </a>
                <div class="article-card__body">
                  <h2 class="article-card__title"><a href="{{ item.url }}">{{ item.title }}</a></h2>
                  <p class="article-card__excerpt">{{ item.content | strip_html | truncatewords: 20 }}</p>
                </div>
              </article>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <p class="search-results__empty">{{ 'general.search.no_results_html' | t: terms: search.terms }}</p>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

{{ 'section-search.css' | asset_url | stylesheet_tag }}

{% schema %}
{
  "name": "Recherche"
}
{% endschema %}
