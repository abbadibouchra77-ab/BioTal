{%- liquid
  assign product = section.settings.product
-%}
<section class="bundle-highlight section" id="shopify-section-{{ section.id }}">
  <div class="page-width">
    <div class="bundle-highlight__card card card--soft">
      <div class="bundle-highlight__media">
        {%- if product.featured_media -%}
          <img
            src="{{ product.featured_media | image_url: width: 700 }}"
            srcset="{{ product.featured_media | image_url: width: 450 }} 450w, {{ product.featured_media | image_url: width: 700 }} 700w"
            sizes="(min-width: 990px) 35vw, 100vw"
            alt="{{ product.featured_media.alt | default: product.title | escape }}"
            width="{{ product.featured_media.width }}"
            height="{{ product.featured_media.height }}"
            loading="lazy"
          >
        {%- else -%}
          {{ 'product-2' | placeholder_svg_tag: 'bundle-highlight__placeholder' }}
        {%- endif -%}
      </div>

      <div class="bundle-highlight__content">
        <span class="badge badge--primary">{{ 'products.badges.bundle' | t }}</span>
        <h2>
          {%- if section.settings.heading != blank -%}
            {{ section.settings.heading }}
          {%- else -%}
            {{ 'sections.bundle_highlight.default_heading' | t }}
          {%- endif -%}
        </h2>
        <div class="bundle-highlight__text">
          {%- if section.settings.subheading != blank -%}
            {{ section.settings.subheading }}
          {%- else -%}
            <p>{{ 'sections.bundle_highlight.default_subheading' | t }}</p>
          {%- endif -%}
        </div>

        {%- if product -%}
          {%- assign variant = product.selected_or_first_available_variant -%}
          <div class="bundle-highlight__prices">
            <div class="bundle-highlight__price-block">
              <span class="bundle-highlight__price-label">{{ 'sections.bundle_highlight.price_label' | t }}</span>
              {%- render 'price', product: product, variant: variant -%}
            </div>
            {%- if variant.compare_at_price > variant.price -%}
              {%- assign savings_amount = variant.compare_at_price | minus: variant.price | money -%}
              <p class="bundle-highlight__savings">
                {{ 'sections.bundle_highlight.savings' | t: amount: savings_amount }}
              </p>
            {%- endif -%}
          </div>
          <a href="{{ product.url }}" class="btn btn--primary btn--lg">{{ 'sections.bundle_highlight.cta' | t }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{{ 'section-bundle-highlight.css' | asset_url | stylesheet_tag }}

{% schema %}
{
  "name": "Bundle vedette",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Produit bundle"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Sous-titre"
    }
  ],
  "presets": [
    {
      "name": "Bundle vedette"
    }
  ]
}
{% endschema %}
