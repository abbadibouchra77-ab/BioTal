<section class="collection-list section" id="shopify-section-{{ section.id }}">
  <div class="page-width">
    <div class="section-header {% if section.settings.center_heading %}section-header--center{% endif %}">
      <h2>
        {%- if section.settings.heading != blank -%}
          {{ section.settings.heading }}
        {%- else -%}
          {{ 'sections.collection_list.default_heading' | t }}
        {%- endif -%}
      </h2>
      {%- if section.settings.subheading != blank -%}
        <p class="section-header__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="grid grid--{{ section.settings.columns_desktop }}">
        {%- for block in section.blocks -%}
          {%- liquid
            assign tile_collection = block.settings.collection
            assign tile_image = block.settings.image | default: tile_collection.featured_image
            assign tile_title = block.settings.title | default: tile_collection.title
          -%}
          {%- if tile_collection != blank -%}
            <a href="{{ tile_collection.url }}" class="collection-list__item card" {{ block.shopify_attributes }}>
              <div class="collection-list__media">
                {%- if tile_image -%}
                  <img
                    src="{{ tile_image | image_url: width: 600 }}"
                    srcset="{{ tile_image | image_url: width: 300 }} 300w, {{ tile_image | image_url: width: 450 }} 450w, {{ tile_image | image_url: width: 600 }} 600w"
                    sizes="(min-width: 990px) 25vw, 50vw"
                    alt="{{ tile_title | escape }}"
                    width="{{ tile_image.width }}"
                    height="{{ tile_image.height }}"
                    loading="lazy"
                  >
                {%- else -%}
                  {{ 'collection-1' | placeholder_svg_tag: 'collection-list__placeholder' }}
                {%- endif -%}
              </div>
              <span class="collection-list__title">{{ tile_title }}</span>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{{ 'section-collection-list.css' | asset_url | stylesheet_tag }}

{% schema %}
{
  "name": "Liste de collections",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Sous-titre"
    },
    {
      "type": "checkbox",
      "id": "center_heading",
      "label": "Centrer le titre",
      "default": true
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Colonnes (ordinateur)",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titre personnalisé (optionnel)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image personnalisée (optionnel, sinon l'image de la collection est utilisée)"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Liste de collections",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
