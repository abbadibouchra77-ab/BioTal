<div class="error-404 section">
  <div class="page-width page-width--narrow error-404__inner">
    {%- render 'icon', name: 'search', size: 40 -%}
    <h1>{{ 'general.404.title' | t }}</h1>
    <p>{{ 'general.404.subtext' | t }}</p>
    <a href="{{ routes.root_url }}" class="btn btn--primary">{{ 'general.404.link' | t }}</a>
  </div>
</div>

{{ 'section-404.css' | asset_url | stylesheet_tag }}

{% schema %}
{
  "name": "Page 404"
}
{% endschema %}
