<div class="blog-list section">
  <div class="page-width">
    <h1 class="section-header section-header--center">{{ blog.title }}</h1>

    {%- paginate blog.articles by 12 -%}
      {%- if blog.articles.size > 0 -%}
        <div class="grid grid--3">
          {%- for article in blog.articles -%}
            <article class="article-card card">
              <a href="{{ article.url }}" class="article-card__media">
                {%- if article.image -%}
                  <img
                    src="{{ article.image | image_url: width: 600 }}"
                    srcset="{{ article.image | image_url: width: 400 }} 400w, {{ article.image | image_url: width: 600 }} 600w, {{ article.image | image_url: width: 900 }} 900w"
                    sizes="(min-width: 700px) 33vw, 100vw"
                    alt="{{ article.image.alt | default: article.title | escape }}"
                    width="{{ article.image.width }}"
                    height="{{ article.image.height }}"
                    loading="lazy"
                  >
                {%- else -%}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'article-card__placeholder' }}
                {%- endif -%}
              </a>
              <div class="article-card__body">
                <p class="article-card__meta">{{ article.published_at | date: '%d %B %Y' }}{% if article.author != blank %} · {{ 'blog.by_author' | t: author: article.author }}{% endif %}</p>
                <h2 class="article-card__title"><a href="{{ article.url }}">{{ article.title }}</a></h2>
                <p class="article-card__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
                <a href="{{ article.url }}" class="article-card__link">{{ 'blog.read_more' | t }}</a>
              </div>
            </article>
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="pagination" aria-label="{{ 'general.pagination.label' | t }}">
            {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">{{ 'general.pagination.previous' | t }}</a>{%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>{%- else -%}<span aria-current="page">{{ part.title }}</span>{%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}<a href="{{ paginate.next.url }}">{{ 'general.pagination.next' | t }}</a>{%- endif -%}
          </nav>
        {%- endif -%}
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{{ 'section-blog.css' | asset_url | stylesheet_tag }}

{% schema %}
{
  "name": "Blog"
}
{% endschema %}
