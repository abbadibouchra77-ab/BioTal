{%- liquid
  assign collection = section.settings.collection
  assign columns = section.settings.columns_desktop | default: '4'
-%}
<section class="featured-collection section" id="shopify-section-{{ section.id }}">
  <div class="page-width">
    <div class="section-header {% if section.settings.center_heading %}section-header--center{% endif %}">
      <h2>
        {%- if section.settings.heading != blank -%}
          {{ section.settings.heading }}
        {%- elsif collection != blank -%}
          {{ collection.title }}
        {%- else -%}
          {{ 'sections.featured_collection.default_heading' | t }}
        {%- endif -%}
      </h2>
      {%- if section.settings.subheading != blank -%}
        <p class="section-header__subheading">{{ section.settings.subheading }}</p>
      {%- else -%}
        <p class="section-header__subheading">{{ 'sections.featured_collection.default_subheading' | t }}</p>
      {%- endif -%}
    </div>

    {%- if collection != blank and collection.products.size > 0 -%}
      <div class="grid grid--{{ columns }}">
        {%- for product in collection.products limit: section.settings.products_to_show -%}
          {%- render 'product-card', product: product -%}
        {%- endfor -%}
      </div>

      {%- if section.settings.show_view_all -%}
        <div class="product-grid-section__footer">
          <a href="{{ collection.url }}" class="btn btn--outline">{{ 'sections.product_grid.view_all' | t }}</a>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection en avant",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Sous-titre"
    },
    {
      "type": "checkbox",
      "id": "center_heading",
      "label": "Centrer le titre",
      "default": true
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Nombre de produits",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Colonnes (ordinateur)",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Afficher le bouton « Voir tout »",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Collection en avant"
    }
  ]
}
{% endschema %}
