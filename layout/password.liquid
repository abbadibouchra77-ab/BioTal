<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <title>{{ shop.name }}</title>
  {%- if settings.favicon -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:wght@600&family=Inter:wght@400;600&display=swap" media="print" onload="this.media='all'">
  <style>
    :root{
      --color-primary: {{ settings.colors_primary }};
      --color-accent: {{ settings.colors_accent }};
      --color-bg: {{ settings.colors_background }};
      --color-bg-secondary: {{ settings.colors_background_secondary }};
      --color-text: {{ settings.colors_text }};
      --color-white: {{ settings.colors_white }};
      --radius: {{ settings.radius_base }}px;
    }
  </style>
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
  <style>
    body{ display:flex; align-items:center; justify-content:center; min-height:100vh; text-align:center; padding:1.5rem; }
    .password-box{ max-width: 26rem; }
    .password-box h1{ margin-bottom: 0.4em; }
    .password-box form{ display:flex; gap:0.5rem; margin-top:1.5rem; flex-wrap:wrap; justify-content:center; }
    .password-box input[type="password"]{ padding:0.85em 1em; border-radius: var(--radius); border:1px solid var(--color-bg-secondary); flex:1; min-width:12rem; }
    .password-box .admin-link{ margin-top:2rem; font-size:0.85rem; color: var(--color-text); opacity:0.7; }
  </style>
</head>
<body>
  <div class="password-box">
    <p class="badge badge--accent">{{ 'general.password_page.opening_soon' | t }}</p>
    <h1>{{ shop.name }}</h1>
    <p>{{ 'general.meta.tagline' | t }}</p>

    {%- form 'storefront_password' -%}
      <h2 class="visually-hidden">{{ 'general.password_page.login_form_heading' | t }}</h2>
      {%- if form.errors -%}
        <p role="alert" style="color: var(--color-error);">{{ 'general.password_page.login_form_error' | t }}</p>
      {%- endif -%}
      <label for="Password" class="visually-hidden">{{ 'general.password_page.login_form_password_label' | t }}</label>
      <input type="password" id="Password" name="password" placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}" required>
      <button type="submit" class="btn btn--primary">{{ 'general.password_page.login_password_button' | t }}</button>
    {%- endform -%}

    <p class="admin-link">{{ 'general.password_page.admin_link_html' | t }}</p>
  </div>
</body>
</html>
