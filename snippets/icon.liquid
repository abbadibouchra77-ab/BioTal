{%- comment -%}
  Icônes SVG inline mutualisées (léger, aucune requête réseau, colorable en CSS via currentColor).
  Usage : {% render 'icon', name: 'cart', size: 20 %}
{%- endcomment -%}
{%- liquid
  assign size = size | default: 20
  assign name = name | default: 'check'
-%}
<svg class="icon icon--{{ name }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'cart' -%}
      <path d="M3 3h2l2.4 12.2a2 2 0 0 0 2 1.6h7.9a2 2 0 0 0 2-1.6L21 7H6" />
      <circle cx="9.5" cy="20.5" r="1.4" fill="currentColor" stroke="none" />
      <circle cx="17.5" cy="20.5" r="1.4" fill="currentColor" stroke="none" />
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="7" />
      <path d="M21 21l-4.3-4.3" />
    {%- when 'menu' -%}
      <path d="M3 6h18M3 12h18M3 18h18" />
    {%- when 'close' -%}
      <path d="M5 5l14 14M19 5L5 19" />
    {%- when 'chevron-down' -%}
      <path d="M6 9l6 6 6-6" />
    {%- when 'chevron-right' -%}
      <path d="M9 6l6 6-6 6" />
    {%- when 'plus' -%}
      <path d="M12 5v14M5 12h14" />
    {%- when 'minus' -%}
      <path d="M5 12h14" />
    {%- when 'truck' -%}
      <path d="M3 6h11v9H3z" />
      <path d="M14 10h4l3 3v2h-7z" />
      <circle cx="7" cy="18" r="1.6" />
      <circle cx="17.5" cy="18" r="1.6" />
    {%- when 'shield' -%}
      <path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z" />
      <path d="M9 12l2 2 4-4" />
    {%- when 'factory' -%}
      <path d="M3 21V11l5 3.5V11l5 3.5V11l6 4v6z" />
      <path d="M17 8V4h2v2l2-1.5V8" />
      <path d="M3 21h18" />
    {%- when 'leaf' -%}
      <path d="M5 20c8 0 14-6 14-14V5h-1C10 5 5 10 5 18z" />
      <path d="M5 20c2-4 5-7 9-9" />
    {%- when 'lock' -%}
      <rect x="5" y="11" width="14" height="9" rx="2" />
      <path d="M8 11V8a4 4 0 0 1 8 0v3" />
    {%- when 'star' -%}
      <path d="M12 3.5l2.6 5.4 5.9.7-4.3 4.1 1 5.9L12 16.7l-5.2 2.9 1-5.9-4.3-4.1 5.9-.7z" fill="currentColor" stroke="none" />
    {%- when 'star-outline' -%}
      <path d="M12 3.5l2.6 5.4 5.9.7-4.3 4.1 1 5.9L12 16.7l-5.2 2.9 1-5.9-4.3-4.1 5.9-.7z" />
    {%- when 'check-circle' -%}
      <circle cx="12" cy="12" r="9" />
      <path d="M8.5 12.5l2.2 2.2 4.8-5" />
    {%- when 'instagram' -%}
      <rect x="3.5" y="3.5" width="17" height="17" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17" cy="7" r="0.6" fill="currentColor" stroke="none" />
    {%- when 'tiktok' -%}
      <path d="M14 3v10.5a3.2 3.2 0 1 1-2.7-3.16" />
      <path d="M14 3c.4 2.4 2 4 4.4 4.3" />
    {%- when 'facebook' -%}
      <path d="M14 21v-7h2.4l.4-3H14V9c0-.9.3-1.5 1.7-1.5H17V4.8C16.6 4.7 15.6 4.6 14.5 4.6c-2.3 0-3.9 1.4-3.9 4V11H8v3h2.6v7z" fill="currentColor" stroke="none" />
    {%- when 'pinterest' -%}
      <circle cx="12" cy="12" r="9" />
      <path d="M9.5 18c.6-1.8 1.4-4.9 1.8-6.6M12 12a2.5 2.5 0 1 1 4.8-1c0 2-1.2 4.4-3 4.4-1 0-1.6-.6-1.8-1.2" />
    {%- when 'quote' -%}
      <path d="M7 8c-2 1-3 3-3 5.5V17h4.5v-4.5H6c0-1.5.7-2.6 2-3.3z" fill="currentColor" stroke="none" />
      <path d="M15 8c-2 1-3 3-3 5.5V17h4.5v-4.5H14c0-1.5.7-2.6 2-3.3z" fill="currentColor" stroke="none" />
    {%- else -%}
      <path d="M8.5 12.5l2.2 2.2 4.8-5" />
      <circle cx="12" cy="12" r="9" />
  {%- endcase -%}
</svg>
